#!/bin/bash
# Used by the winbars scratchpad button: sends the active window to the
# scratchpad, or, if it's already there, pulls it back onto the workspace
# that's currently shown behind it on the focused monitor.

set -euo pipefail

active_ws="$(hyprctl activewindow -j | jq -r '.workspace.name')"

if [[ "$active_ws" == special:* ]]; then
	target_ws="$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .activeWorkspace.id')"
	hyprctl dispatch movetoworkspace "$target_ws"
else
	hyprctl dispatch movetoworkspacesilent special:scratchpad
fi
