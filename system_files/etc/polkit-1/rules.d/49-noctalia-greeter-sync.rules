// Keep this policy as narrow as possible: a local wheel user may authenticate and
// keep authorization for the greeter-specific action and for the specific
// Noctalia greeter systemd unit that is managed from the UWSM session. This
// matches the Polkit best-practice of allowing only the exact action and exact
// unit instead of a blanket manage-units rule.
polkit.addRule(function(action, subject) {
    if (!subject.active || !subject.local || !subject.isInGroup("wheel")) {
        return polkit.Result.NOT_HANDLED;
    }

    if (action.id == "org.noctalia.greeter.apply-appearance") {
        return polkit.Result.YES;
    }

    if (action.id == "org.freedesktop.systemd1.manage-units") {
        var unit = String(action.lookup("unit") || action.lookupPath || "").toLowerCase();
        var verb = String(action.lookup("verb") || "").toLowerCase();
        var isNoctaliaGreeter = unit.indexOf("noctalia") !== -1 && unit.indexOf("greeter") !== -1;
        var allowedVerbs = ["start", "stop", "restart", "reload", "try-restart"];
        var allowedVerb = allowedVerbs.indexOf(verb) !== -1;

        if (isNoctaliaGreeter && allowedVerb) {
            return polkit.Result.YES;
        }
    }

    return polkit.Result.NOT_HANDLED;
});
